<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.jobscheduler</groupId>
    <artifactId>job-scheduler-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- Build order is worked out by Maven from the dependencies, not this list. -->
    <modules>
        <module>common</module>
        <module>db-migrations</module>
        <module>api-service</module>
        <module>watcher-service</module>
        <module>worker-service</module>
        <module>generator-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <aws-sdk.version>2.55.3</aws-sdk.version>
        <spring-cloud-aws.version>4.1.1</spring-cloud-aws.version>
        <json-schema-validator.version>3.0.7</json-schema-validator.version>
    </properties>

    <!-- Versions only: a module gets a dependency only by declaring it (without a version). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jobscheduler</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- AWS SDK first: it wins over the older SDK version Spring Cloud AWS would bring. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>${spring-cloud-aws.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
